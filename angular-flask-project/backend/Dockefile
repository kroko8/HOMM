# Utilizar una imagen base de Node.js para construir Angular
FROM node:16 as build

# Establecer el directorio de trabajo
WORKDIR /app

# Copiar los archivos del frontend
COPY . .

# Instalar las dependencias y construir la aplicación
RUN npm install && npm run build --prod

# Utilizar una imagen base de Nginx para servir la aplicación
FROM nginx:alpine

# Copiar los archivos construidos al servidor Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Exponer el puerto para Nginx
EXPOSE 80

# Comando para ejecutar Nginx
CMD ["nginx", "-g", "daemon off;"]